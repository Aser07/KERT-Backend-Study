<%- include('partials/header') %>
<h2>글 목록</h2>
<% if (user) { %>
  <a href="/posts/new"><button>글쓰기</button></a>
<% } %>
<ul>
  <% posts.forEach(post => { %>
    <li>
      <a href="/posts/<%= post.id %>">[<%= post.id %>] <%= post.title %></a> 
      (<%= post.username %>)
    </li>
  <% }) %>
</ul>
<%- include('partials/footer') %>