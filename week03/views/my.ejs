<%- include('partials/header') %>

<h2>내가 쓴 글 목록</h2>

<% if (posts.length === 0) { %>
  <p>작성한 글이 없습니다.</p>
<% } else { %>
  <ul>
    <% posts.forEach(post => { %>
      <li>
        <a href="/posts/<%= post.id %>">[<%= post.id %>] <%= post.title %></a> 
        (<%= post.username %>)
      </li>
    <% }) %>
  </ul>
<% } %>

<br>
<a href="/posts">전체 목록으로</a>

<%- include('partials/footer') %>